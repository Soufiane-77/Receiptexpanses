{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "receiptexpanses",
  "main": "worker-entry.mjs",
  // Hourly cron drives the Autopilot Blog. The tick self-limits via
  // interval_hours / daily_cap / min_spacing_minutes, so firing hourly yields
  // the configured posts-per-day without drifting past a 6-hourly boundary.
  "triggers": { "crons": ["0 * * * *"] },
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Blog cover images live here so they are served from our own domain.
  // R2 is the better store for media but needs a one-time dashboard
  // activation; KV works today and the code prefers R2 whenever it is bound.
  "kv_namespaces": [
    { "binding": "BLOG_IMAGES_KV", "id": "e05005e28c8545ce9222a2ea890950e4" }
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  // Non-secret config vars. GOOGLE_CLIENT_ID is a public OAuth identifier (it is
  // sent to the browser during sign-in), so it lives here in config â€” this also
  // ensures `wrangler deploy` preserves it. GOOGLE_CLIENT_SECRET is a real secret,
  // set via `wrangler secret put GOOGLE_CLIENT_SECRET` (do NOT put it here).
  "vars": {
    "GOOGLE_CLIENT_ID": "771778083827-44mjsm6gncjdbij0ouiaqnl0ijapv5s3.apps.googleusercontent.com"
  },
  // Cloudflare D1 (SQLite) database. Create it once with:
  //   npx wrangler d1 create receiptexpanses-db
  // then paste the printed database_id below (replace REPLACE_WITH_D1_DATABASE_ID).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "receiptexpanses-db",
      "database_id": "123ebbc3-8f2d-42c9-915f-8e7593715265",
      "migrations_dir": "migrations"
    }
  ]
}
